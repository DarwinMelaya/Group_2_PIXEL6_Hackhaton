{
  "expo": {
    "name": "GabAI",
    "slug": "gabai",
    "scheme": "gabai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#e8590c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.dale_123.gabai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "GabAI needs access to your photos so you can attach images of hazards or injuries.",
          "cameraPermission": "GabAI needs camera access so you can capture images of hazards or injuries.",
          "microphonePermission": "GabAI uses the microphone so you can talk to the assistant."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GabAI uses your location to show emergency hotlines for the barangay you are in."
        }
      ],
      "llama.rn",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GabAI uses the microphone so you can talk to the assistant.",
          "speechRecognitionPermission": "GabAI transcribes what you say into a chat message.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "35105477-6349-44cc-ab8d-ce77744a8216"
      }
    }
  }
}
